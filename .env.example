# BD Legal Guide AI — Backend Environment Variables

# REQUIRED: Google Gemini API Key (get from https://ai.google.dev/)
GOOGLE_API_KEY=your-api-key-here

# OPTIONAL: Override defaults
# EMBEDDING_MODEL=models/text-embedding-004
# GENERATION_MODEL=gemini-1.5-flash
# FAISS_INDEX_PATH=indexes/faiss_index
# TOP_K_RETRIEVAL=20
# TOP_N_RERANK=5
# BM25_WEIGHT=0.4
# FAISS_WEIGHT=0.6
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200

# Payments & Checkout (simulated | sslcommerz)
PAYMENT_PROVIDER=sslcommerz

# SSLCommerz Sandbox / Production Gateway
# Store ID provided by SSLCommerz (use sandbox credentials for testing)
SSLCZ_STORE_ID=your_sslcz_store_id
# Store Password / Secret Key provided by SSLCommerz
SSLCZ_STORE_PASSWD=your_sslcz_store_password
# Set to 'true' for sandbox environment (https://sandbox.sslcommerz.com), 'false' for live
SSLCZ_SANDBOX=true

# Service Application URLs
# Frontend URL for post-checkout redirects (e.g., http://localhost:5173/pricing?status=success)
FRONTEND_URL=http://localhost:5173
# Backend URL used by SSLCommerz for return URLs and IPN webhooks
BACKEND_URL=http://127.0.0.1:8000

